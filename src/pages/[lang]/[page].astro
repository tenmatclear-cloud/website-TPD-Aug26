---
import BaseLayout from '@layouts/BaseLayout.astro';
import { localize, pageTitles, ui } from '@content/i18n';
import { activeLanguages, staticPages, workshop, type Lang } from '@content/programme';

type StaticPage = 'resources' | 'logistics' | 'media';

export function getStaticPaths() {
  const pages = ['resources', 'logistics', 'media'] as const;
  return activeLanguages.flatMap(({ code }) => pages.map((page) => ({ params: { lang: code, page } })));
}

const lang = Astro.params.lang as Lang;
const page = Astro.params.page as StaticPage;
const content = staticPages[page];
---

<BaseLayout
  title={`${localize(pageTitles[page], lang)} | ${localize(workshop.projectName, lang)}`}
  description={localize(content.intro, lang)}
  lang={lang}
  currentPath={page}
>
  <section class="hero">
    <div class="hero-inner">
      <div>
        <span class="eyebrow">{localize(workshop.projectName, lang)}</span>
        <h1>{localize(content.title, lang)}</h1>
        <p>{localize(content.intro, lang)}</p>
      </div>
      <aside class="hero-panel">
        <dl>
          <div>
            <dt>{localize(ui.date, lang)}</dt>
            <dd>{localize(workshop.dateRange, lang)}</dd>
          </div>
          <div>
            <dt>{localize(ui.venue, lang)}</dt>
            <dd>{localize(workshop.venue, lang)}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <div class="content-shell">
    <section class="section">
      <div class="info-list">
        {
          content.items.map((item) => (
            <article
              class:list={[
                'info-item',
                item.variant === 'warning' && 'info-item-warning',
                item.variant === 'highlight' && 'info-item-highlight',
              ]}
            >
              <h3>{localize(item.title, lang)}</h3>
              {item.columns ? (
                <div class="info-columns">
                  {item.columns.map((column) => (
                    <div class="info-column">
                      <p class="info-column-label">{localize(column.label, lang)}</p>
                      <p class="info-column-name">{column.name}</p>
                      {column.phone && (
                        <a class="info-column-phone" href={`tel:${column.phone.replace(/\s/g, '')}`}>
                          {column.phone}
                        </a>
                      )}
                      {column.email && (
                        <a class="info-column-email" href={`mailto:${column.email}`}>
                          {column.email}
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                item.body && <p>{localize(item.body, lang)}</p>
              )}
              {item.links ? (
                <div class="resource-links">
                  {item.links.map((link) => (
                    <div class="resource-link-group">
                      {link.note && <p class="resource-link-note">{localize(link.note, lang)}</p>}
                      {link.href ? (
                        <a class="resource-link" href={link.href} target="_blank" rel="noopener noreferrer">
                          {localize(link.linkLabel, lang)}
                        </a>
                      ) : (
                        <span class="resource-link resource-link-pending">{localize(link.linkLabel, lang)}</span>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                item.linkLabel && (
                  item.href ? (
                    <a class="resource-link" href={item.href} target="_blank" rel="noopener noreferrer">
                      {localize(item.linkLabel, lang)}
                    </a>
                  ) : (
                    <span class="resource-link resource-link-pending">{localize(item.linkLabel, lang)}</span>
                  )
                )
              )}
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
