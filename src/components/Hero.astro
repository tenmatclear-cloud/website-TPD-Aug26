---
import { localize, pageTitles, pathFor, ui } from '@content/i18n';
import { workshop, type Lang } from '@content/programme';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div>
      <h1>{localize(workshop.title, lang)}</h1>
      <p>{localize(workshop.heroIntro, lang)}</p>
      <div class="hero-actions">
        <a class="button primary" href={pathFor(lang, 'day-1')}>{localize(ui.viewProgramme, lang)}</a>
        <a class="button ghost" href={pathFor(lang, 'resources')}>{localize(pageTitles.resources, lang)}</a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Workshop summary">
      <dl>
        <div>
          <dt>{localize(ui.date, lang)}</dt>
          <dd>{localize(workshop.dateRange, lang)}</dd>
        </div>
        <div>
          <dt>{localize(ui.venue, lang)}</dt>
          <dd>{localize(workshop.venue, lang)}</dd>
        </div>
        <div>
          <dt>{localize(ui.audience, lang)}</dt>
          <dd>{localize(workshop.audience, lang)}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
