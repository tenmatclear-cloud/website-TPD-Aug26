---
import BaseLayout from '@layouts/BaseLayout.astro';
import { localize, pageTitles, ui } from '@content/i18n';
import { languages, logistics, resources, workshop, type Lang } from '@content/programme';

type StaticPage = 'resources' | 'logistics' | 'media';

export function getStaticPaths() {
  const pages = ['resources', 'logistics', 'media'] as const;
  return languages.flatMap(({ code }) => pages.map((page) => ({ params: { lang: code, page } })));
}

const lang = Astro.params.lang as Lang;
const page = Astro.params.page as StaticPage;

const introByPage = {
  resources: ui.resourcesIntro,
  logistics: ui.logisticsIntro,
  media: ui.mediaIntro,
};

const contentByPage = {
  resources,
  logistics,
  media: [
    {
      title: pageTitles.media,
      body: ui.mediaIntro,
    },
  ],
};
---

<BaseLayout
  title={`${localize(pageTitles[page], lang)} | ${localize(workshop.projectName, lang)}`}
  description={localize(introByPage[page], lang)}
  lang={lang}
  currentPath={page}
>
  <section class="hero">
    <div class="hero-inner">
      <div>
        <span class="eyebrow">{localize(workshop.projectName, lang)}</span>
        <h1>{localize(pageTitles[page], lang)}</h1>
        <p>{localize(introByPage[page], lang)}</p>
      </div>
      <aside class="hero-panel">
        <dl>
          <div>
            <dt>{localize(ui.date, lang)}</dt>
            <dd>{localize(workshop.dateRange, lang)}</dd>
          </div>
          <div>
            <dt>{localize(ui.venue, lang)}</dt>
            <dd>{localize(workshop.venue, lang)}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <div class="content-shell">
    <section class="section">
      <div class="section-header">
        <div>
          <span class="eyebrow" style="color: var(--color-primary); border-color: var(--color-border);">
            {localize(pageTitles[page], lang)}
          </span>
          <h2>{localize(pageTitles[page], lang)}</h2>
          <p>{localize(introByPage[page], lang)}</p>
        </div>
      </div>

      <div class="info-list">
        {
          contentByPage[page].map((item) => (
            <article class="info-item">
              <h3>{localize(item.title, lang)}</h3>
              <p>{localize(item.body, lang)}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
