---
import Hero from '@components/Hero.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { localize, pageTitles, pathFor, ui } from '@content/i18n';
import {
  featureAccents,
  features,
  impact,
  activeLanguages,
  takeaways,
  workshop,
  type Lang,
} from '@content/programme';

export function getStaticPaths() {
  return activeLanguages.map(({ code }) => ({ params: { lang: code } }));
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout
  title={`${localize(pageTitles.home, lang)} | ${localize(workshop.projectName, lang)}`}
  description={localize(workshop.heroIntro, lang)}
  lang={lang}
>
  <Hero lang={lang} />

  <div class="content-shell">
    <!-- Feature cards: Three days, one community -->
    <section id="programme" class="section">
      <div class="section-header">
        <div>
          <span class="eyebrow eyebrow-dark">{localize(features.eyebrow, lang)}</span>
          <h2>{localize(features.title, lang)}</h2>
        </div>
        <a class="button ghost-dark" href={pathFor(lang, 'day-1')}>{localize(ui.viewProgramme, lang)}</a>
      </div>

      <div class="grid">
        {
          features.items.map((card) => (
            <article class="card" style={`--accent: ${featureAccents[card.accent]}`}>
              <span class="meta">{localize(card.meta, lang)}</span>
              <h3>{localize(card.title, lang)}</h3>
              <p>{localize(card.desc, lang)}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Impact at a glance: yellow / navy split -->
    <section class="split-section">
      <div>
        <span class="eyebrow eyebrow-dark">{localize(impact.eyebrow, lang)}</span>
        <h2>{localize(impact.title, lang)}</h2>
      </div>
      <div class="dark">
        <div class="stat-grid">
          {
            impact.stats.map((stat) => (
              <div class="stat">
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{localize(stat.label, lang)}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Takeaways: What you'll take away -->
    <section id="takeaways" class="section">
      <div class="section-header">
        <div>
          <span class="eyebrow eyebrow-dark">{localize(takeaways.eyebrow, lang)}</span>
          <h2>{localize(takeaways.title, lang)}</h2>
        </div>
      </div>
      <ul class="objectives">
        {takeaways.items.map((item) => <li>{localize(item, lang)}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>
