---
import { activeLanguages, slidoUrl, workshop, type Lang } from '@content/programme';
import { localize, navItems, pathFor, ui } from '@content/i18n';

type Props = {
  lang: Lang;
  currentPath: string;
};

const { lang, currentPath } = Astro.props;
const normalizedPath = currentPath.replace(/^\/|\/$/g, '');

const openMenuLabel = localize(ui.openMenu, lang);
const closeMenuLabel = localize(ui.closeMenu, lang);
const mainNavLabel = localize(ui.mainNav, lang);
const mobileNavLabel = localize(ui.mobileNav, lang);
const showLanguageSwitcher = activeLanguages.length > 1;
const askLabel = localize(ui.askQuestion, lang);
const askShortLabel = localize(ui.askQuestionShort, lang);
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand-link" href={pathFor(lang)} aria-label={localize(workshop.projectName, lang)}>
      <span class="brand-logo"><img src="/brand/JC-Project_AI-Logo_TC_EN.png" alt="JC GoAI" width="603" height="120" /></span>
      <span class="brand">
        {localize(workshop.projectName, lang)}
        <span>{localize(workshop.title, lang)}</span>
      </span>
    </a>

    <div class="header-end">
      <nav class="nav" aria-label={mainNavLabel}>
        {
          navItems
            .filter((item) => !item.hidden)
            .map((item) => {
            const itemPath = item.href;
            const isCurrent = itemPath === normalizedPath || (!itemPath && !normalizedPath);
            return (
              <a href={pathFor(lang, itemPath)} aria-current={isCurrent ? 'page' : undefined}>
                {localize(item.label, lang)}
              </a>
            );
          })
        }
      </nav>

      <a
        class="header-cta header-cta--desktop"
        href={slidoUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {askLabel}
      </a>

      {
        showLanguageSwitcher && (
          <nav class="language-switcher" aria-label={localize(ui.language, lang)}>
            {activeLanguages.map((language) => (
              <a
                href={pathFor(language.code, normalizedPath)}
                lang={language.code === 'zh-hk' ? 'zh-Hant-HK' : 'en'}
                aria-current={language.code === lang ? 'true' : undefined}
              >
                {language.shortLabel}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <a
      class="header-cta header-cta--compact"
      href={slidoUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {askShortLabel}
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-controls="mobile-drawer"
      aria-expanded="false"
      aria-label={openMenuLabel}
    >
      <span class="menu-toggle-bar" aria-hidden="true"></span>
      <span class="menu-toggle-bar" aria-hidden="true"></span>
      <span class="menu-toggle-bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="drawer-overlay" hidden></div>

<aside class="mobile-drawer" id="mobile-drawer" hidden>
    <button class="drawer-close" type="button" aria-label={closeMenuLabel}>
      <span class="drawer-close-bar" aria-hidden="true"></span>
      <span class="drawer-close-bar" aria-hidden="true"></span>
    </button>
    <nav class="nav mobile-nav" aria-label={mobileNavLabel}>
      {
        navItems
          .filter((item) => !item.hidden)
          .map((item) => {
          const itemPath = item.href;
          const isCurrent = itemPath === normalizedPath || (!itemPath && !normalizedPath);
          return (
            <a href={pathFor(lang, itemPath)} aria-current={isCurrent ? 'page' : undefined}>
              {localize(item.label, lang)}
            </a>
          );
        })
      }
    </nav>
    <a
      class="header-cta header-cta--drawer"
      href={slidoUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {askLabel}
    </a>
  </aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const drawer = document.querySelector<HTMLElement>('.mobile-drawer');
  const overlay = document.querySelector<HTMLElement>('.drawer-overlay');
  const closeBtn = document.querySelector<HTMLButtonElement>('.drawer-close');

  if (toggle && drawer && overlay) {
    let transitioning = false;

    const focusableSelector = 'a[href], button:not([disabled])';

    const getFocusable = () =>
      [...drawer.querySelectorAll<HTMLElement>(focusableSelector)].filter(
        (el) => !el.hasAttribute('hidden') && el.getClientRects().length > 0,
      );

    const openMenu = () => {
      drawer.hidden = false;
      overlay.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
        const first = getFocusable()[0] ?? closeBtn;
        first?.focus();
      });
    };

    const closeMenu = () => {
      if (transitioning) return;
      transitioning = true;
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      const finish = () => {
        drawer.hidden = true;
        overlay.hidden = true;
        transitioning = false;
        drawer.removeEventListener('transitionend', finish);
      };
      drawer.addEventListener('transitionend', finish);
      setTimeout(() => {
        if (transitioning) {
          drawer.hidden = true;
          overlay.hidden = true;
          transitioning = false;
        }
      }, 400);
      toggle.focus();
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => {
      isOpen() ? closeMenu() : openMenu();
    });

    overlay.addEventListener('click', closeMenu);
    closeBtn?.addEventListener('click', closeMenu);

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        closeMenu();
        return;
      }
      if (e.key !== 'Tab') return;
      const nodes = getFocusable();
      if (nodes.length === 0) return;
      const first = nodes[0];
      const last = nodes[nodes.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
