---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { localize, ui } from '@content/i18n';
import type { Lang } from '@content/programme';
import '@styles/global.css';

type Props = {
  title: string;
  description: string;
  lang: Lang;
  currentPath?: string;
};

const { title, description, lang, currentPath = '' } = Astro.props;
---

<!doctype html>
<html lang={lang === 'zh-hk' ? 'zh-Hant-HK' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{localize(ui.skipToContent, lang)}</a>
    <Header lang={lang} currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
