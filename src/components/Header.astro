---
import { activeLanguages, workshop, type Lang } from '@content/programme';
import { localize, navItems, pathFor, ui } from '@content/i18n';

type Props = {
  lang: Lang;
  currentPath: string;
};

const { lang, currentPath } = Astro.props;
const normalizedPath = currentPath.replace(/^\/|\/$/g, '');

const openMenuLabel = 'Open menu';
const closeMenuLabel = 'Close menu';
const showLanguageSwitcher = activeLanguages.length > 1;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand-link" href={pathFor(lang)} aria-label={localize(workshop.projectName, lang)}>
      <span class="brand-logo"><img src="/brand/JC-Project_AI-Logo_TC_EN.png" alt="JC GoAI" width="4100" height="816" /></span>
      <span class="brand">
        {localize(workshop.projectName, lang)}
        <span>{localize(workshop.title, lang)}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      {
        navItems
          .filter((item) => !item.hidden)
          .map((item) => {
          const itemPath = item.href;
          const isCurrent = itemPath === normalizedPath || (!itemPath && !normalizedPath);
          return (
            <a href={pathFor(lang, itemPath)} aria-current={isCurrent ? 'page' : undefined}>
              {localize(item.label, lang)}
            </a>
          );
        })
      }
    </nav>

    {
      showLanguageSwitcher && (
        <div class="language-switcher" aria-label={localize(ui.language, lang)}>
          {activeLanguages.map((language) => (
            <a
              href={pathFor(language.code, normalizedPath)}
              lang={language.code === 'zh-hk' ? 'zh-Hant-HK' : 'en'}
              aria-current={language.code === lang ? 'true' : undefined}
            >
              {language.shortLabel}
            </a>
          ))}
        </div>
      )
    }

    <button
      class="menu-toggle"
      type="button"
      aria-controls="mobile-drawer"
      aria-expanded="false"
      aria-label={openMenuLabel}
    >
      <span class="menu-toggle-bar" aria-hidden="true"></span>
      <span class="menu-toggle-bar" aria-hidden="true"></span>
      <span class="menu-toggle-bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="drawer-overlay" hidden></div>

<aside class="mobile-drawer" id="mobile-drawer" hidden>
    <button class="drawer-close" type="button" aria-label={closeMenuLabel}>
      <span class="drawer-close-bar" aria-hidden="true"></span>
      <span class="drawer-close-bar" aria-hidden="true"></span>
    </button>
    <nav class="nav mobile-nav" aria-label="Main navigation">
      {
        navItems
          .filter((item) => !item.hidden)
          .map((item) => {
          const itemPath = item.href;
          const isCurrent = itemPath === normalizedPath || (!itemPath && !normalizedPath);
          return (
            <a href={pathFor(lang, itemPath)} aria-current={isCurrent ? 'page' : undefined}>
              {localize(item.label, lang)}
            </a>
          );
        })
      }
    </nav>
  </aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const drawer = document.querySelector<HTMLElement>('.mobile-drawer');
  const overlay = document.querySelector<HTMLElement>('.drawer-overlay');
  const closeBtn = document.querySelector<HTMLButtonElement>('.drawer-close');

  if (toggle && drawer && overlay) {
    let transitioning = false;

    const openMenu = () => {
      drawer.hidden = false;
      overlay.hidden = false;
      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
      });
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      const firstLink = drawer.querySelector<HTMLAnchorElement>('a');
      if (firstLink) firstLink.focus();
    };

    const closeMenu = () => {
      if (transitioning) return;
      transitioning = true;
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      const finish = () => {
        drawer.hidden = true;
        overlay.hidden = true;
        transitioning = false;
        drawer.removeEventListener('transitionend', finish);
      };
      drawer.addEventListener('transitionend', finish);
      setTimeout(() => {
        if (transitioning) {
          drawer.hidden = true;
          overlay.hidden = true;
          transitioning = false;
        }
      }, 400);
      toggle.focus();
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => {
      isOpen() ? closeMenu() : openMenu();
    });

    overlay.addEventListener('click', closeMenu);
    closeBtn?.addEventListener('click', closeMenu);

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) closeMenu();
    });
  }
</script>
