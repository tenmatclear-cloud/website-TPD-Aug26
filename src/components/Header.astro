---
import { languages, workshop, type Lang } from '@content/programme';
import { localize, navItems, pathFor, ui } from '@content/i18n';

type Props = {
  lang: Lang;
  currentPath: string;
};

const { lang, currentPath } = Astro.props;
const normalizedPath = currentPath.replace(/^\/|\/$/g, '');
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand-link" href={pathFor(lang)} aria-label={localize(workshop.projectName, lang)}>
      <span class="brand-logo"><img src="/brand/goai-mark.png" alt="JC GoAI" width="40" height="40" /></span>
      <span class="brand">
        {localize(workshop.projectName, lang)}
        <span>{localize(workshop.title, lang)}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      {
        navItems.map((item) => {
          const itemPath = item.href;
          const isCurrent = itemPath === normalizedPath || (!itemPath && !normalizedPath);
          return (
            <a href={pathFor(lang, itemPath)} aria-current={isCurrent ? 'page' : undefined}>
              {localize(item.label, lang)}
            </a>
          );
        })
      }
    </nav>

    <div class="language-switcher" aria-label={localize(ui.language, lang)}>
      {
        languages.map((language) => (
          <a
            href={pathFor(language.code, normalizedPath)}
            lang={language.code === 'zh-hk' ? 'zh-Hant-HK' : 'en'}
            aria-current={language.code === lang ? 'true' : undefined}
          >
            {language.shortLabel}
          </a>
        ))
      }
    </div>
  </div>
</header>
