---
import { localize, pageTitles, pathFor, ui } from '@content/i18n';
import { workshop, type Lang } from '@content/programme';

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
// Chrome mobile concatenates the heading year with the next line ("2026 Empowering
// Hong Kong") and treats it as a Maps/address entity. A zero-width non-joiner after
// the year breaks that match without changing how the title looks or copies.
const title = localize(workshop.title, lang).replace(/(20\d{2})/g, '$1\u200c');
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1>{title}</h1>
      <p>{localize(workshop.heroIntro, lang)}</p>
      <div class="hero-actions">
        <a class="button primary" href={pathFor(lang, 'day-1')}>{localize(ui.viewProgramme, lang)}</a>
        <a class="button ghost" href={pathFor(lang, 'resources')}>{localize(pageTitles.resources, lang)}</a>
      </div>
    </div>

    <aside class="hero-panel" aria-label={localize(ui.workshopSummary, lang)}>
      <dl>
        <div>
          <dt>{localize(ui.date, lang)}</dt>
          <dd>{localize(workshop.dateRange, lang)}</dd>
        </div>
        <div>
          <dt>{localize(ui.venue, lang)}</dt>
          <dd>{localize(workshop.venue, lang)}</dd>
        </div>
        <div>
          <dt>{localize(ui.audience, lang)}</dt>
          <dd>{localize(workshop.audience, lang)}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
