---
import { localize, ui } from '@content/i18n';
import type { Lang, Session } from '@content/programme';

type Props = {
  lang: Lang;
  sessions: Session[];
};

const { lang, sessions } = Astro.props;
---

<div class="timeline">
  {
    sessions.map((session) =>
      session.heading ? (
        <div class="timeline-band">
          <h3>{localize(session.heading, lang)}</h3>
          {session.note && <span>{localize(session.note, lang)}</span>}
        </div>
      ) : (
        <article class="timeline-item">
          <div class="time-block">
            {session.time}
            {session.duration && <span>{session.duration}</span>}
          </div>

          {session.tracks ? (
            <div class="track-grid">
              {session.tracks.map((track) => (
                <div class="track">
                  <span class="tag">{localize(track.audience, lang)}</span>
                  <h3>{localize(track.title, lang)}</h3>
                  {track.speakers && (
                    <p>
                      <strong>{localize(ui.speakers, lang)}:</strong> {localize(track.speakers, lang)}
                    </p>
                  )}
                  {track.abstract && <p>{localize(track.abstract, lang)}</p>}
                </div>
              ))}
            </div>
          ) : (
            <div>
              <h3>{session.title && localize(session.title, lang)}</h3>
              {session.speakers && (
                <p>
                  <strong>{localize(ui.speakers, lang)}:</strong> {localize(session.speakers, lang)}
                </p>
              )}
              {session.abstract && (
                <p>
                  <strong>{localize(ui.abstract, lang)}:</strong> {localize(session.abstract, lang)}
                </p>
              )}
              {session.note && <p class="muted-note">{localize(session.note, lang)}</p>}
            </div>
          )}
        </article>
      )
    )
  }
</div>
