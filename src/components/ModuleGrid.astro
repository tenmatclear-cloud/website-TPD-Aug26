---
import { localize, ui } from '@content/i18n';
import type { Lang, ModuleSession } from '@content/programme';

type Props = {
  lang: Lang;
  modules: ModuleSession[];
};

const { lang, modules } = Astro.props;
---

<div class="module-grid">
  {
    modules.map((module) => (
      <article class="module-card">
        <div class="module-card-top">
          <div class="tag-row">
            <span class="tag">{localize(module.audience, lang)}</span>
            {module.lessons && <span class="tag tag-soft">{localize(module.lessons, lang)}</span>}
          </div>
          {module.room && (
            <span
              class:list={[
                'module-room',
                module.room.includes('YIA') && !module.room.includes('WMY') && 'module-room--yia',
              ]}
            >
              {module.room.split(' / ').map((part) => (
                <span class="module-room-part">{part}</span>
              ))}
            </span>
          )}
        </div>
        <h3>{localize(module.title, lang)}</h3>
        {module.abstract && <p>{localize(module.abstract, lang)}</p>}
        <div class="module-facilitators">
          <p><strong>{localize(ui.facilitators, lang)}:</strong></p>
          <ul>
            {module.facilitators.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>
